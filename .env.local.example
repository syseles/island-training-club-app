# Local environment overrides for the ITC prototype.
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.

# Supabase project URL (browser-safe, also embedded in app/index.html).
SUPABASE_URL=

# Browser-safe anon / public key (also embedded in app/index.html).
SUPABASE_ANON_KEY=

# Supabase server-side credentials — DO NOT paste the DB password into the
# browser config. These values are only used by trusted server-side tooling
# (e.g. supabase db push from a workstation). Never embed in HTML.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase personal access token for `supabase login` (separate from the
# database password; issued at https://supabase.com/dashboard/account/tokens).
SUPABASE_ACCESS_TOKEN=
